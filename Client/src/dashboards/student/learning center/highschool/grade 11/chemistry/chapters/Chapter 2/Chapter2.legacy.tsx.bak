  },
} as const;

type ExerciseAccent = keyof typeof exerciseAccents;

interface ExerciseProps {
  number: string;
  accent: ExerciseAccent;
  question: React.ReactNode;
  answer: React.ReactNode;
}

const Exercise: React.FC<ExerciseProps> = ({
  number,
  accent,
  question,
  answer,
}) => {
  const styles = exerciseAccents[accent];

  return (
    <div className="bg-white dark:bg-slate-900 border-2 border-dashed border-slate-300 dark:border-slate-700 rounded-2xl p-6 sm:p-8 relative mt-12">
      <div className="absolute -top-5 left-6 sm:left-8 bg-white dark:bg-slate-900 px-4 py-1 rounded-full border border-slate-200 dark:border-slate-700 shadow-sm flex items-center gap-2 text-sm font-bold text-slate-700 dark:text-slate-300">
        <BookOpen size={16} className={styles.icon} />
        Inline Exercise {number}
      </div>
      <div className="mt-2">
        <div className="font-medium text-slate-800 dark:text-slate-200 mb-4">
          {question}
        </div>

        <details className="group">
          <summary
            className={`cursor-pointer font-medium transition-colors flex items-center gap-2 list-none [&::-webkit-details-marker]:hidden ${styles.text}`}
          >
            <span
              className={`group-open:hidden border px-4 py-2 rounded-lg text-sm inline-block ${styles.chip}`}
            >
              Show Answer
            </span>
            <span
              className={`hidden group-open:inline-block border px-4 py-2 rounded-lg text-sm ${styles.chip}`}
            >
              Hide Answer
            </span>
          </summary>
          <div className="mt-4 p-4 bg-green-50 dark:bg-green-900/20 text-green-800 dark:text-green-300 rounded-xl border border-green-200 dark:border-green-800/50 text-sm leading-relaxed">
            {answer}
          </div>
        </details>
      </div>
    </div>
  );
};

const atomicModels = [
  {
    year: "1803",
    title: "Dalton's billiard-ball model",
    idea: "Atoms are tiny, indivisible, indestructible spheres. Each element has atoms of a characteristic mass.",
    limitation:
      "Could not account for subatomic particles, ions, or isotopes.",
  },
  {
    year: "1897",
    title: "Thomson's plum-pudding model",
    idea: "Negative electrons are embedded in a uniform sphere of positive charge, like seeds in a watermelon.",
    limitation:
      "Could not explain the large-angle scattering of alpha particles.",
  },
  {
    year: "1911",
    title: "Rutherford's nuclear model",
    idea: "A tiny, dense, positive nucleus holds nearly all the mass, with electrons in the surrounding empty space.",
    limitation:
      "Classical physics predicted orbiting electrons would radiate energy and spiral into the nucleus; it also could not explain line spectra.",
  },
  {
    year: "1913",
    title: "Bohr's planetary model",
    idea: "Electrons travel in fixed circular orbits. Angular momentum is quantized, and photons are emitted or absorbed during jumps between levels.",
    limitation:
      "Worked only for one-electron species such as H, He⁺, and Li²⁺; failed for multi-electron atoms and fine structure.",
  },
  {
    year: "1926",
    title: "Quantum mechanical model",
    idea: "Schrödinger's wave equation replaces fixed orbits with orbitals — regions of high probability. Quantum numbers label each electron state.",
    limitation:
      "Abstract and probabilistic; it gives no definite electron path, consistent with the Heisenberg uncertainty principle.",
  },
];

const hydrogenLevels = [
  { level: "n = ∞", energy: "0 eV", width: "w-full" },
  { level: "n = 4", energy: "−0.85 eV", width: "w-11/12" },
  { level: "n = 3", energy: "−1.51 eV", width: "w-3/4" },
  { level: "n = 2", energy: "−3.40 eV", width: "w-1/2" },
  { level: "n = 1", energy: "−13.6 eV", width: "w-1/4" },
];

const orbitalFillingOrder = [
  "1s",
  "2s",
  "2p",
  "3s",
  "3p",
  "4s",
  "3d",
  "4p",
  "5s",
  "4d",
  "5p",
  "6s",
  "4f",
  "5d",
  "6p",
];

interface OrbitalGroup {
  label: string;
  boxes: string[];
}

interface OrbitalDiagramProps {
  element: string;
  configuration: string;
  groups: OrbitalGroup[];
}

const OrbitalDiagram: React.FC<OrbitalDiagramProps> = ({
  element,
  configuration,
  groups,
}) => (
  <div className="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/40 p-5">
    <div className="flex flex-wrap items-baseline justify-between gap-2 mb-4">
      <h5 className="m-0 text-base font-bold text-slate-900 dark:text-white">
        {element}
      </h5>
      <code className="rounded-md bg-white dark:bg-slate-900 px-2 py-1 text-xs font-mono text-green-700 dark:text-green-400 border border-slate-200 dark:border-slate-700">
        {configuration}
      </code>
    </div>
    <div className="flex flex-wrap gap-4">
      {groups.map((group) => (
        <div key={group.label}>
          <div className="mb-1 text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            {group.label}
          </div>
          <div className="flex gap-1">
            {group.boxes.map((electrons, index) => (
              <div
                key={`${group.label}-${index}`}
                className="flex h-9 w-9 items-center justify-center rounded-md border border-slate-300 bg-white text-[11px] font-bold leading-none text-green-700 dark:border-slate-600 dark:bg-slate-900 dark:text-green-400"
              >
                {electrons}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
);

export const Chapter2: React.FC<ChapterProps> = ({ selectedSubtopic }) => {
  // Scroll to subtopic when selected
  useEffect(() => {
    if (selectedSubtopic) {
      const subtopicId = selectedSubtopic
        .split(".")
        .slice(0, 2)
        .join(".")
        .trim();
      const element = document.getElementById(`subtopic-${subtopicId}`);
      if (element) {
        element.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }
  }, [selectedSubtopic]);

  return (
    <div className="max-w-5xl mx-auto px-4 sm:px-6 py-8">
