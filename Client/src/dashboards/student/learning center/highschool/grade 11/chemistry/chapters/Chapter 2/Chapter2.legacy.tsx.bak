                      </th>
                      <th className="px-4 py-3 text-left font-bold text-slate-700 dark:text-slate-200">
                        Max electrons
                      </th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-200 dark:divide-slate-700">
                    {[
                      { name: "s", l: "0", orbitals: "1", electrons: "2" },
                      { name: "p", l: "1", orbitals: "3", electrons: "6" },
                      { name: "d", l: "2", orbitals: "5", electrons: "10" },
                      { name: "f", l: "3", orbitals: "7", electrons: "14" },
                    ].map((row) => (
                      <tr key={row.name}>
                        <td className="px-4 py-3 font-bold text-purple-700 dark:text-purple-300">
                          {row.name}
                        </td>
                        <td className="px-4 py-3 text-slate-700 dark:text-slate-300">
                          {row.l}
                        </td>
                        <td className="px-4 py-3 text-slate-700 dark:text-slate-300">
                          {row.orbitals}
                        </td>
                        <td className="px-4 py-3 text-slate-700 dark:text-slate-300">
                          {row.electrons}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              {/* Shell Table */}
              <h4 className="flex items-center gap-2 text-xl font-bold text-slate-900 dark:text-white mt-8 mb-4">
                <Table2 className="h-5 w-5 text-purple-500" />
                Capacity of the first four shells
              </h4>

              <div className="my-6 overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-700">
                <table className="w-full min-w-[520px] text-sm m-0">
                  <thead className="bg-slate-100 dark:bg-slate-800">
                    <tr>
                      <th className="px-4 py-3 text-left font-bold text-slate-700 dark:text-slate-200">
                        n
                      </th>
                      <th className="px-4 py-3 text-left font-bold text-slate-700 dark:text-slate-200">
                        Shell
                      </th>
                      <th className="px-4 py-3 text-left font-bold text-slate-700 dark:text-slate-200">
                        Subshells
                      </th>
                      <th className="px-4 py-3 text-left font-bold text-slate-700 dark:text-slate-200">
                        Orbitals (n²)
                      </th>
                      <th className="px-4 py-3 text-left font-bold text-slate-700 dark:text-slate-200">
                        Max e⁻ (2n²)
                      </th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-200 dark:divide-slate-700">
                    {[
                      { n: "1", shell: "K", subshells: "1s", orbitals: "1", electrons: "2" },
                      { n: "2", shell: "L", subshells: "2s 2p", orbitals: "4", electrons: "8" },
                      { n: "3", shell: "M", subshells: "3s 3p 3d", orbitals: "9", electrons: "18" },
                      { n: "4", shell: "N", subshells: "4s 4p 4d 4f", orbitals: "16", electrons: "32" },
                    ].map((row) => (
                      <tr key={row.n}>
                        <td className="px-4 py-3 font-bold text-purple-700 dark:text-purple-300">
                          {row.n}
                        </td>
                        <td className="px-4 py-3 text-slate-700 dark:text-slate-300">
                          {row.shell}
                        </td>
                        <td className="px-4 py-3 text-slate-700 dark:text-slate-300">
                          {row.subshells}
                        </td>
                        <td className="px-4 py-3 text-slate-700 dark:text-slate-300">
                          {row.orbitals}
                        </td>
                        <td className="px-4 py-3 text-slate-700 dark:text-slate-300">
                          {row.electrons}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              {/* Orbital Shapes */}
              <h4 className="text-xl font-bold text-slate-900 dark:text-white mt-8 mb-2">
                Orbital shapes
              </h4>
              <p className="text-sm text-slate-600 dark:text-slate-400 mb-4">
                The l value controls the shape of the probability cloud. These
                are schematic cross-sections, not particle paths.
              </p>

              <div className="grid grid-cols-2 gap-4 sm:grid-cols-4 my-6">
                <div className="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/40 p-4 text-center">
                  <div className="flex h-20 items-center justify-center">
                    <div className="h-16 w-16 rounded-full border-2 border-purple-300 bg-purple-400/25 dark:border-purple-700 dark:bg-purple-500/20" />
                  </div>
                  <p className="m-0 mt-2 text-sm font-bold text-slate-900 dark:text-white">
                    s orbital
                  </p>
                  <p className="m-0 text-xs text-slate-500 dark:text-slate-400">
                    spherical · 1 orientation
                  </p>
                </div>

                <div className="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/40 p-4 text-center">
                  <div className="flex h-20 items-center justify-center">
                    <div className="flex flex-col items-center gap-0.5">
                      <div className="h-7 w-10 rounded-t-full rounded-b-[40%] border-2 border-purple-300 bg-purple-400/25 dark:border-purple-700 dark:bg-purple-500/20" />
                      <div className="h-7 w-10 rounded-b-full rounded-t-[40%] border-2 border-purple-300 bg-purple-400/25 dark:border-purple-700 dark:bg-purple-500/20" />
                    </div>
                  </div>
                  <p className="m-0 mt-2 text-sm font-bold text-slate-900 dark:text-white">
                    p orbital
                  </p>
                  <p className="m-0 text-xs text-slate-500 dark:text-slate-400">
                    dumbbell · 3 orientations
                  </p>
                </div>

                <div className="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/40 p-4 text-center">
                  <div className="flex h-20 items-center justify-center">
                    <div className="grid grid-cols-2 gap-0.5 rotate-45">
                      <div className="h-7 w-7 rounded-full border-2 border-purple-300 bg-purple-400/25 dark:border-purple-700 dark:bg-purple-500/20" />
                      <div className="h-7 w-7 rounded-full border-2 border-purple-300 bg-purple-400/25 dark:border-purple-700 dark:bg-purple-500/20" />
                      <div className="h-7 w-7 rounded-full border-2 border-purple-300 bg-purple-400/25 dark:border-purple-700 dark:bg-purple-500/20" />
                      <div className="h-7 w-7 rounded-full border-2 border-purple-300 bg-purple-400/25 dark:border-purple-700 dark:bg-purple-500/20" />
                    </div>
                  </div>
                  <p className="m-0 mt-2 text-sm font-bold text-slate-900 dark:text-white">
                    d orbital
                  </p>
                  <p className="m-0 text-xs text-slate-500 dark:text-slate-400">
                    double dumbbell · 5 orientations
                  </p>
                </div>

                <div className="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/40 p-4 text-center">
                  <div className="flex h-20 items-center justify-center">
                    <div className="grid grid-cols-3 gap-0.5">
                      {[0, 1, 2, 3, 4, 5].map((petal) => (
                        <div
                          key={petal}
                          className="h-5 w-5 rounded-full border-2 border-purple-300 bg-purple-400/25 dark:border-purple-700 dark:bg-purple-500/20"
                        />
                      ))}
                    </div>
                  </div>
                  <p className="m-0 mt-2 text-sm font-bold text-slate-900 dark:text-white">
                    f orbital
                  </p>
                  <p className="m-0 text-xs text-slate-500 dark:text-slate-400">
                    complex · 7 orientations
                  </p>
                </div>
              </div>

              {/* Real World Analogy */}
              <div className="bg-gradient-to-r from-purple-50 to-fuchsia-50 dark:from-purple-900/20 dark:to-fuchsia-900/20 rounded-2xl p-6 sm:p-8 my-8 border border-purple-200/50 dark:border-purple-700/30">
                <div className="flex items-start gap-4">
                  <div className="p-3 bg-purple-100 dark:bg-purple-800/50 rounded-xl text-purple-600 dark:text-purple-400 mt-1">
                    <Lightbulb size={24} />
                  </div>
                  <div>
                    <h4 className="text-lg font-bold text-purple-900 dark:text-purple-300 mb-2 m-0">
                      Real-World Analogy: An Electron's Postal Address
                    </h4>
                    <div className="space-y-1.5 text-sm text-purple-800/80 dark:text-purple-200/80">
                      <p className="m-0">
                        <strong>Country → n:</strong> which shell the electron
                        lives in.
                      </p>
                      <p className="m-0">
                        <strong>State → l:</strong> which subshell (s, p, d, f).
                      </p>
                      <p className="m-0">
                        <strong>City → m<sub>l</sub>:</strong> which orbital
                        within that subshell.
                      </p>
                      <p className="m-0">
                        <strong>House number → m<sub>s</sub>:</strong> the
                        electron's spin.
                      </p>
                      <p className="m-0 pt-2 text-xs italic">
                        Pauli's exclusion principle says no two electrons in an
                        atom may share the same complete address.
                      </p>
                    </div>
                  </div>
                </div>
              </div>

              <Exercise
                number="2.3"
                accent="purple"
                question={
                  <div>
                    <p className="m-0 mb-3">
                      (a) How many orbitals and how many electrons can the n = 4
                      shell hold? List its subshells.
                    </p>
                    <p className="m-0">
                      (b) Which set of quantum numbers is not allowed: n = 2, l
                      = 1, m<sub>l</sub> = 0, or n = 2, l = 2, m<sub>l</sub> =
                      1?
                    </p>
                  </div>
                }
                answer={
                  <div className="space-y-3">
                    <div>
                      <p className="m-0 font-bold">(a) The n = 4 shell:</p>
                      <p className="m-0">
                        Subshells: 4s, 4p, 4d, 4f.
                      </p>
                      <p className="m-0">
                        Orbitals: 1 + 3 + 5 + 7 = <strong>16</strong> (n²).
                      </p>
                      <p className="m-0">
                        Electrons: 16 × 2 = <strong>32</strong> (2n²).
                      </p>
                    </div>
                    <div>
                      <p className="m-0 font-bold">(b) The invalid set:</p>
                      <p className="m-0">
                        n = 2, l = 2 is not allowed. For n = 2, l may only be 0
                        or 1 because l ≤ n − 1.
                      </p>
                    </div>
                  </div>
                }
              />
            </div>
          </div>
        </motion.section>

        {/* Section 2.4 */}
        <motion.section
          variants={itemVariants}
          id="subtopic-2.4"
          className="scroll-mt-24"
        >
          <div className={cardClass}>
            <div className={sectionHeaderClass}>
              <div
                className={`${numberBoxClass} bg-teal-100 dark:bg-teal-900/40 text-teal-600 dark:text-teal-400`}
              >
                2.4
              </div>
              <h3 className="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">
                Electronic Configuration
              </h3>
            </div>

            <div className={proseClass}>
              <p className="lead text-xl text-slate-700 dark:text-slate-200 font-medium mb-8">
                Electronic configuration is the arrangement of electrons among
                orbitals. Three rules decide the order, and those rules explain
                the shape of the periodic table.
              </p>

              {/* Three Rules */}
              <div className="grid gap-4 md:grid-cols-3 my-8">
                <div className="rounded-2xl border border-green-100 dark:border-green-800/60 bg-green-50/50 dark:bg-green-900/10 p-5">
                  <div className="mb-3 flex h-9 w-9 items-center justify-center rounded-xl bg-green-100 dark:bg-green-900/50 text-green-600 dark:text-green-400">
                    <Zap className="h-4 w-4" />
                  </div>
                  <h4 className="m-0 text-base font-bold text-green-900 dark:text-green-300">
                    Aufbau principle
                  </h4>
                  <p className="m-0 mt-2 text-sm leading-relaxed">
                    Build up from the lowest-energy orbital. Orbitals fill in
                    order of increasing (n + l); if two have the same (n + l),
                    the one with lower n fills first.
                  </p>
                </div>

                <div className="rounded-2xl border border-blue-100 dark:border-blue-800/60 bg-blue-50/50 dark:bg-blue-900/10 p-5">
                  <div className="mb-3 flex h-9 w-9 items-center justify-center rounded-xl bg-blue-100 dark:bg-blue-900/50 text-blue-600 dark:text-blue-400">
                    <CircleDot className="h-4 w-4" />
                  </div>
                  <h4 className="m-0 text-base font-bold text-blue-900 dark:text-blue-300">
                    Pauli exclusion principle
                  </h4>
                  <p className="m-0 mt-2 text-sm leading-relaxed">
                    No two electrons in an atom can have the same set of four
                    quantum numbers. Therefore an orbital holds at most two
                    electrons, with opposite spins.
                  </p>
                </div>

                <div className="rounded-2xl border border-amber-100 dark:border-amber-800/60 bg-amber-50/50 dark:bg-amber-900/10 p-5">
                  <div className="mb-3 flex h-9 w-9 items-center justify-center rounded-xl bg-amber-100 dark:bg-amber-900/50 text-amber-600 dark:text-amber-400">
                    <GitBranch className="h-4 w-4" />
                  </div>
                  <h4 className="m-0 text-base font-bold text-amber-900 dark:text-amber-300">
                    Hund's rule
                  </h4>
                  <p className="m-0 mt-2 text-sm leading-relaxed">
                    Degenerate orbitals (same energy) are occupied singly with
                    parallel spins first. Pairing begins only after every
                    orbital in the subshell has one electron.
                  </p>
                </div>
              </div>

              {/* Filling Order */}
              <h4 className="text-xl font-bold text-slate-900 dark:text-white mt-8 mb-3">
                Orbital filling order
              </h4>
              <div className="my-5 rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/40 p-5">
                <div className="flex flex-wrap items-center gap-1.5">
                  {orbitalFillingOrder.map((subshell, index) => (
                    <React.Fragment key={subshell}>
                      <span
                        className={`rounded-lg border px-2.5 py-1 text-xs font-mono font-bold ${
                          subshell === "4s" || subshell === "3d"
                            ? "border-amber-300 bg-amber-100 text-amber-800 dark:border-amber-700 dark:bg-amber-900/40 dark:text-amber-300"
                            : "border-slate-200 bg-white text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300"
                        }`}
                      >
                        {subshell}
                      </span>
                      {index < orbitalFillingOrder.length - 1 && (
                        <ArrowRight className="h-3.5 w-3.5 text-slate-400 dark:text-slate-500" />
                      )}
                    </React.Fragment>
                  ))}
                </div>
                <p className="m-0 mt-4 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
                  Note the highlighted pair: <strong>4s fills before 3d</strong>{" "}
                  because 4s has a lower (n + l) value. Once filled, the 3d
                  electrons are written before 4s in the final configuration.
                </p>
              </div>

              {/* Orbital Diagrams */}
              <h4 className="text-xl font-bold text-slate-900 dark:text-white mt-8 mb-2">
                Reading orbital diagrams
              </h4>
              <p className="text-sm text-slate-600 dark:text-slate-400 mb-4">
                Each box is one orbital. Arrows show electron spin. Carbon,
                nitrogen, and oxygen show Hund's rule in action.
              </p>

              <div className="space-y-3 my-5">
                <OrbitalDiagram
                  element="Carbon (Z = 6)"
                  configuration="1s² 2s² 2p²"
                  groups={[
                    { label: "1s", boxes: ["↑↓"] },
                    { label: "2s", boxes: ["↑↓"] },
                    { label: "2p", boxes: ["↑", "↑", ""] },
                  ]}
                />
                <OrbitalDiagram
                  element="Nitrogen (Z = 7)"
                  configuration="1s² 2s² 2p³"
                  groups={[
                    { label: "1s", boxes: ["↑↓"] },
                    { label: "2s", boxes: ["↑↓"] },
                    { label: "2p", boxes: ["↑", "↑", "↑"] },
                  ]}
                />
                <OrbitalDiagram
                  element="Oxygen (Z = 8)"
                  configuration="1s² 2s² 2p⁴"
                  groups={[
                    { label: "1s", boxes: ["↑↓"] },
                    { label: "2s", boxes: ["↑↓"] },
                    { label: "2p", boxes: ["↑↓", "↑", "↑"] },
                  ]}
                />
              </div>

              <div className="rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/40 p-5 my-5">
                <p className="m-0 text-sm leading-relaxed">
                  In carbon, the third 2p electron enters an empty 2p orbital
                  with parallel spin — not the orbital that already has one
                  electron. Pairing costs energy because electrons repel one
                  another; Hund's rule reflects that repulsion.
                </p>
              </div>

              {/* Configuration Table */}
              <h4 className="text-xl font-bold text-slate-900 dark:text-white mt-8 mb-3">
                Worked configurations
              </h4>
              <div className="my-5 overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-700">
                <table className="w-full min-w-[520px] text-sm m-0">
                  <thead className="bg-slate-100 dark:bg-slate-800">
                    <tr>
                      <th className="px-4 py-3 text-left font-bold text-slate-700 dark:text-slate-200">
                        Element
                      </th>
                      <th className="px-4 py-3 text-left font-bold text-slate-700 dark:text-slate-200">
                        Z
                      </th>
                      <th className="px-4 py-3 text-left font-bold text-slate-700 dark:text-slate-200">
                        Electronic configuration
                      </th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-200 dark:divide-slate-700">
                    {[
                      { element: "Hydrogen", z: "1", config: "1s¹" },
                      { element: "Carbon", z: "6", config: "1s² 2s² 2p²" },
                      { element: "Sodium", z: "11", config: "[Ne] 3s¹" },
                      { element: "Chlorine", z: "17", config: "[Ne] 3s² 3p⁵" },
                      { element: "Iron", z: "26", config: "[Ar] 3d⁶ 4s²" },
                    ].map((row) => (
                      <tr key={row.element}>
                        <td className="px-4 py-3 font-semibold text-slate-800 dark:text-slate-200">
                          {row.element}
                        </td>
                        <td className="px-4 py-3 text-slate-600 dark:text-slate-400">
                          {row.z}
                        </td>
                        <td className="px-4 py-3 font-mono text-teal-700 dark:text-teal-400">
                          {row.config}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              {/* Exceptions */}
              <div className="rounded-2xl border border-amber-200 dark:border-amber-800/60 bg-amber-50/60 dark:bg-amber-900/15 p-5 sm:p-6 my-6">
                <h4 className="m-0 mb-3 text-base font-bold text-amber-900 dark:text-amber-300">
                  Two important exceptions: chromium and copper
                </h4>
                <div className="grid gap-3 sm:grid-cols-2">
                  <div className="rounded-xl bg-white dark:bg-slate-900 p-4 border border-amber-100 dark:border-amber-800/60">
                    <p className="m-0 text-sm font-bold text-slate-900 dark:text-white">
                      Chromium (Z = 24)
                    </p>
                    <p className="m-0 mt-1 font-mono text-sm text-amber-700 dark:text-amber-400">
                      [Ar] 3d⁵ 4s¹
                    </p>
                  </div>
                  <div className="rounded-xl bg-white dark:bg-slate-900 p-4 border border-amber-100 dark:border-amber-800/60">
                    <p className="m-0 text-sm font-bold text-slate-900 dark:text-white">
                      Copper (Z = 29)
                    </p>
                    <p className="m-0 mt-1 font-mono text-sm text-amber-700 dark:text-amber-400">
                      [Ar] 3d¹⁰ 4s¹
                    </p>
                  </div>
                </div>
                <p className="m-0 mt-3 text-xs leading-relaxed text-slate-700 dark:text-slate-300">
                  A half-filled (d⁵) or completely filled (d¹⁰) d subshell has
                  extra stability. The atom promotes one 4s electron into 3d
                  to reach that arrangement.
                </p>
              </div>

              {/* Blocks */}
              <h4 className="text-xl font-bold text-slate-900 dark:text-white mt-8 mb-3">
                Configurations and the periodic table
              </h4>
              <div className="grid gap-4 sm:grid-cols-2 my-5">
                <div className="rounded-2xl border border-green-100 dark:border-green-800/60 bg-green-50/50 dark:bg-green-900/10 p-4">
                  <p className="m-0 text-sm font-bold text-green-900 dark:text-green-300">
                    s-block
                  </p>
                  <p className="m-0 mt-1 font-mono text-xs text-green-700 dark:text-green-400">
                    ns¹⁻²
                  </p>
                  <p className="m-0 mt-1 text-xs text-slate-600 dark:text-slate-400">
                    Groups 1–2 and helium.
                  </p>
                </div>
                <div className="rounded-2xl border border-blue-100 dark:border-blue-800/60 bg-blue-50/50 dark:bg-blue-900/10 p-4">
                  <p className="m-0 text-sm font-bold text-blue-900 dark:text-blue-300">
                    p-block
                  </p>
                  <p className="m-0 mt-1 font-mono text-xs text-blue-700 dark:text-blue-400">
                    ns² np¹⁻⁶
                  </p>
                  <p className="m-0 mt-1 text-xs text-slate-600 dark:text-slate-400">
                    Groups 13–18.
                  </p>
                </div>
                <div className="rounded-2xl border border-purple-100 dark:border-purple-800/60 bg-purple-50/50 dark:bg-purple-900/10 p-4">
                  <p className="m-0 text-sm font-bold text-purple-900 dark:text-purple-300">
                    d-block
                  </p>
                  <p className="m-0 mt-1 font-mono text-xs text-purple-700 dark:text-purple-400">
                    (n − 1)d¹⁻¹⁰ ns⁰⁻²
                  </p>
                  <p className="m-0 mt-1 text-xs text-slate-600 dark:text-slate-400">
                    Groups 3–12, the transition metals.
                  </p>
                </div>
                <div className="rounded-2xl border border-rose-100 dark:border-rose-800/60 bg-rose-50/50 dark:bg-rose-900/10 p-4">
                  <p className="m-0 text-sm font-bold text-rose-900 dark:text-rose-300">
                    f-block
                  </p>
                  <p className="m-0 mt-1 font-mono text-xs text-rose-700 dark:text-rose-400">
                    (n − 2)f¹⁻¹⁴
                  </p>
                  <p className="m-0 mt-1 text-xs text-slate-600 dark:text-slate-400">
                    Lanthanides and actinides.
                  </p>
                </div>
              </div>

              {/* Real World Example */}
              <div className="bg-gradient-to-r from-teal-50 to-cyan-50 dark:from-teal-900/20 dark:to-cyan-900/20 rounded-2xl p-6 sm:p-8 my-8 border border-teal-200/50 dark:border-teal-700/30">
                <div className="flex items-start gap-4">
                  <div className="p-3 bg-teal-100 dark:bg-teal-800/50 rounded-xl text-teal-600 dark:text-teal-400 mt-1">
                    <Sparkles size={24} />
                  </div>
                  <div>
                    <h4 className="text-lg font-bold text-teal-900 dark:text-teal-300 mb-2 m-0">
                      Real-World Example: Sodium Street Lamps
                    </h4>
                    <p className="m-0 text-teal-800/80 dark:text-teal-200/80 leading-relaxed">
                      Sodium's configuration is [Ne] 3s¹. In a street lamp, the
                      electrical discharge excites that 3s electron to 3p. When
                      it drops back, it emits light at 589 nm — the familiar
                      yellow glow. The same link between electron configuration
                      and light explains the colours of fireworks and neon
                      signs.
                    </p>
                  </div>
                </div>
              </div>

              <Exercise
                number="2.4"
                accent="teal"
                question={
                  <p className="m-0">
                    Write the full and noble-gas shorthand electronic
                    configurations of chlorine (Z = 17) and iron (Z = 26). Then
                    state how many unpaired electrons each atom has.
                  </p>
                }
                answer={
                  <div className="space-y-3">
                    <div>
                      <p className="m-0 font-bold">Chlorine (Z = 17)</p>
                      <p className="m-0 font-mono">
                        1s² 2s² 2p⁶ 3s² 3p⁵ = [Ne] 3s² 3p⁵
                      </p>
                      <p className="m-0">
                        The 3p subshell has five electrons: two pairs and one
                        unpaired electron. <strong>1 unpaired electron.</strong>
                      </p>
                    </div>
                    <div>
                      <p className="m-0 font-bold">Iron (Z = 26)</p>
                      <p className="m-0 font-mono">
                        1s² 2s² 2p⁶ 3s² 3p⁶ 3d⁶ 4s² = [Ar] 3d⁶ 4s²
                      </p>
                      <p className="m-0">
                        The five 3d orbitals hold six electrons: one pair plus
                        four single electrons.{" "}
                        <strong>4 unpaired electrons.</strong>
                      </p>
                    </div>
                  </div>
                }
              />
            </div>
          </div>
        </motion.section>

        {/* Summary */}
        <motion.section variants={itemVariants} className="scroll-mt-24">
          <div className="bg-gradient-to-br from-green-600 to-teal-700 rounded-3xl p-8 sm:p-10 text-white shadow-xl">
            <h3 className="text-2xl sm:text-3xl font-bold mb-6">
              Chapter 2 Summary
            </h3>
            <div className="space-y-3 text-green-50">
              <div className="flex items-start gap-3">
                <CircleCheck className="mt-0.5 h-5 w-5 shrink-0 text-green-200" />
                <p className="m-0">
                  Atoms contain electrons, protons, and neutrons. Atomic number
                  Z counts protons; mass number A = Z + neutrons.
                </p>
              </div>
              <div className="flex items-start gap-3">
                <CircleCheck className="mt-0.5 h-5 w-5 shrink-0 text-green-200" />
                <p className="m-0">
                  Atomic models evolved from indivisible spheres to a nuclear
                  model, quantized Bohr orbits, and finally probability
                  orbitals.
                </p>
              </div>
              <div className="flex items-start gap-3">
                <CircleCheck className="mt-0.5 h-5 w-5 shrink-0 text-green-200" />
                <p className="m-0">
                  The four quantum numbers n, l, m<sub>l</sub>, and m<sub>s</sub>{" "}
                  specify an electron's shell, subshell, orbital, and spin. A
                  shell holds up to 2n² electrons.
                </p>
              </div>
              <div className="flex items-start gap-3">
                <CircleCheck className="mt-0.5 h-5 w-5 shrink-0 text-green-200" />
                <p className="m-0">
                  Configurations follow the Aufbau principle, Pauli exclusion
                  principle, and Hund's rule; chromium and copper are the
                  classic exceptions.
                </p>
              </div>
            </div>

            <div className="mt-8 rounded-2xl border border-white/20 bg-white/10 p-5 backdrop-blur-sm">
              <p className="m-0 text-sm font-bold uppercase tracking-wider text-green-200">
                Core formulas to remember
              </p>
              <div className="mt-3 grid gap-3 sm:grid-cols-3 text-sm">
                <p className="m-0">
                  <strong>Z = protons</strong>
                </p>
                <p className="m-0">
                  <strong>A = Z + N</strong>
                </p>
                <p className="m-0">
                  <strong>Max e⁻ in a shell = 2n²</strong>
                </p>
              </div>
            </div>
          </div>
        </motion.section>

        {/* Next Up */}
        <motion.section variants={itemVariants}>
          <div className="bg-white dark:bg-slate-900 rounded-3xl p-6 sm:p-8 border border-slate-100 dark:border-slate-800 shadow-lg shadow-slate-200/50 dark:shadow-none flex flex-col sm:flex-row sm:items-center gap-5">
            <div className="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-green-100 dark:bg-green-900/40 text-green-600 dark:text-green-400">
              <ArrowRight className="h-6 w-6" />
            </div>
            <div className="flex-1">
              <p className="m-0 text-xs font-bold uppercase tracking-wider text-green-600 dark:text-green-400">
                Next up
              </p>
              <h3 className="m-0 mt-1 text-xl font-bold text-slate-900 dark:text-white">
                Chapter 3: Chemical Bonding
              </h3>
              <p className="m-0 mt-1 text-sm text-slate-600 dark:text-slate-400">
                Now that you know how electrons are arranged, see how atoms
                share or transfer them to form ionic and covalent bonds.
              </p>
            </div>
          </div>
        </motion.section>
      </motion.div>
    </div>
  );
};

export default Chapter2;
