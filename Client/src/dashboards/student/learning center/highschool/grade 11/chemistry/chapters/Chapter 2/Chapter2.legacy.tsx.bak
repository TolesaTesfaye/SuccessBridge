          <div className="mt-8 flex flex-wrap gap-2">
            {[
              "2.1 Subatomic particles",
              "2.2 Atomic models",
              "2.3 Quantum numbers",
              "2.4 Electronic configuration",
            ].map((label) => (
              <span
                key={label}
                className="rounded-full border border-white/20 bg-white/10 px-3 py-1 text-xs font-medium text-green-50 backdrop-blur-sm"
              >
                {label}
              </span>
            ))}
          </div>
        </div>
      </motion.div>

      <motion.div
        variants={containerVariants}
        initial="hidden"
        animate="visible"
        className="space-y-16 pb-20"
      >
        {/* Section 2.1 */}
        <motion.section
          variants={itemVariants}
          id="subtopic-2.1"
          className="scroll-mt-24"
        >
          <div className={cardClass}>
            <div className={sectionHeaderClass}>
              <div
